datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// USER & IDENTITY MODELS
// ==========================================

model User {
  id               String               @id @default(uuid())
  email            String               @unique
  passwordHash     String
  firstName        String
  lastName         String
  avatarUrl        String?
  phone            String?
  jobTitle         String?
  department       String?
  timezone         String               @default("UTC")
  locale           String               @default("en-US")
  isEmailVerified  Boolean              @default(false)
  twoFactorEnabled Boolean              @default(false)
  twoFactorSecret  String?
  status           String               @default("ACTIVE")
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  memberships           OrganizationMember[]
  sessions              Session[]
  refreshTokens         RefreshToken[]
  auditLogs             AuditLog[]
  securityLogs          SecurityLog[]

  createdConversations  Conversation[]           @relation("CreatedConversations")
  participations        ConversationParticipant[]
  sentMessages          Message[]                @relation("SentMessages")
  messageReceipts       MessageReceipt[]
  notifications         Notification[]
  presence              UserPresence?

  assignedLeads         Lead[]                   @relation("AssignedLeads")
  assignedDeals         Deal[]                   @relation("AssignedDeals")
  assignedTasks         Task[]                   @relation("AssignedTasks")
  uploadedDocuments     CustomerDocument[]       @relation("UploadedDocuments")
  assignedTickets       Ticket[]                 @relation("AssignedTickets")
  ticketComments        TicketComment[]          @relation("UserTicketComments")
  authoredArticles      KnowledgeArticle[]       @relation("AuthoredArticles")
  articleVersions       KnowledgeArticleVersion[]@relation("VersionAuthors")
  activities            Activity[]               @relation("UserActivities")
  createdWorkflows      WorkflowRule[]           @relation("CreatedWorkflows")
  apiKeys               ApiKey[]                 @relation("CreatedApiKeys")
  createdReports        ReportDefinition[]       @relation("CreatedReports")
  createdTemplates      EmailTemplate[]          @relation("CreatedTemplates")
  cannedResponses       CannedResponse[]         @relation("CreatedCannedResponses")
  campaigns             BroadcastCampaign[]      @relation("CreatedCampaigns")
  customerNotes         CustomerNote[]           @relation("AuthoredNotes")
  createdQuotes         DealQuote[]              @relation("CreatedQuotes")
  createdPrompts        AiPromptTemplate[]       @relation("CreatedPrompts")
  managedQueues         TicketQueueMember[]
  csatResponses         CsatResponse[]           @relation("AgentCsatResponses")
  etlJobs               EtlImportJob[]           @relation("UserEtlJobs")

  @@map("users")
}

model Organization {
  id            String               @id @default(uuid())
  name          String
  slug          String               @unique
  logoUrl       String?
  domain        String?
  industry      String?
  currency      String               @default("USD")
  timezone      String               @default("UTC")
  maxUsers      Int                  @default(10)
  status        String               @default("ACTIVE")
  metadata      String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  members       OrganizationMember[]
  teams         Team[]
  conversations Conversation[]
  notifications Notification[]
  auditLogs     AuditLog[]

  companies     Company[]
  contacts      Contact[]
  leads         Lead[]
  pipelines     Pipeline[]
  deals         Deal[]
  activities    Activity[]
  tasks         Task[]
  documents     CustomerDocument[]
  tickets       Ticket[]
  ticketQueues  TicketQueue[]
  articles      KnowledgeArticle[]
  workflows     WorkflowRule[]
  apiKeys       ApiKey[]
  webhooks      WebhookEndpoint[]
  customFields  CustomFieldDefinition[]
  channels      ChannelConfig[]
  reports       ReportDefinition[]
  templates     EmailTemplate[]
  cannedResponses CannedResponse[]
  slaPolicies   SlaPolicy[]
  campaigns     BroadcastCampaign[]
  macros        Macro[]
  leadScoring   LeadScoringRule[]
  subscriptions Subscription[]
  invoices      SubscriptionInvoice[]
  products      ProductCatalog[]
  csatSurveys   CsatSurvey[]
  prompts       AiPromptTemplate[]
  routingRules  TicketRoutingRule[]
  tags          EntityTag[]
  etlJobs       EtlImportJob[]
  ssoConfigs    SamlSsoConfig[]

  @@map("organizations")
}

model Team {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  description    String?
  leadUserId     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        TeamMember[]
  tickets        Ticket[]     @relation("TeamTickets")
  queues         TicketQueue[]

  @@map("teams")
}

model OrganizationMember {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  role           String       @default("MEMBER")
  status         String       @default("ACTIVE")
  invitedBy      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  teams          TeamMember[]

  @@unique([organizationId, userId])
  @@map("organization_members")
}

model TeamMember {
  id                   String             @id @default(uuid())
  teamId               String
  organizationMemberId String
  role                 String             @default("MEMBER")
  createdAt            DateTime           @default(now())

  team                 Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  member               OrganizationMember @relation(fields: [organizationMemberId], references: [id], onDelete: Cascade)

  @@unique([teamId, organizationMemberId])
  @@map("team_members")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  ipAddress String?
  userAgent String?
  deviceType String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model SamlSsoConfig {
  id             String       @id @default(uuid())
  organizationId String
  idpEntityId    String
  ssoUrl         String
  certificate    String
  domain         String       @unique
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("saml_sso_configs")
}

// ==========================================
// BILLING & SUBSCRIPTION MODELS
// ==========================================

model SubscriptionPlan {
  id             String         @id @default(uuid())
  name           String
  code           String         @unique
  description    String?
  priceMonthly   Float
  priceYearly    Float
  maxSeats       Int            @default(5)
  maxContacts    Int            @default(1000)
  maxWorkflows   Int            @default(10)
  features       String         @default("[]")
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())

  subscriptions  Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id                 String           @id @default(uuid())
  organizationId     String
  planId             String
  status             String           @default("ACTIVE")
  billingCycle       String           @default("MONTHLY")
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean          @default(false)
  stripeCustomerId   String?
  stripeSubId        String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan               SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  usageRecords       UsageRecord[]
  invoices           SubscriptionInvoice[]

  @@map("subscriptions")
}

model SubscriptionInvoice {
  id             String       @id @default(uuid())
  organizationId String
  subscriptionId String?
  number         String       @unique
  amount         Float
  currency       String       @default("USD")
  status         String       @default("PAID")
  pdfUrl         String?
  paidAt         DateTime?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription   Subscription?@relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@map("subscription_invoices")
}

model UsageRecord {
  id             String       @id @default(uuid())
  subscriptionId String
  metric         String
  quantity       Int          @default(1)
  recordedAt     DateTime     @default(now())

  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("usage_records")
}

// ==========================================
// CHANNELS & OMNICHANNEL INTEGRATIONS
// ==========================================

model ChannelConfig {
  id             String       @id @default(uuid())
  organizationId String
  type           String       @default("WHATSAPP")
  name           String
  credentials    String       @default("{}")
  settings       String       @default("{}")
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversations  Conversation[]
  webhookLogs    ChannelWebhookLog[]
  telephonyTrunks TelephonyTrunk[]

  @@map("channel_configs")
}

model ChannelWebhookLog {
  id              String        @id @default(uuid())
  channelConfigId String
  eventType       String
  payload         String        @default("{}")
  status          String        @default("PROCESSED")
  errorMessage    String?
  createdAt       DateTime      @default(now())

  channelConfig   ChannelConfig @relation(fields: [channelConfigId], references: [id], onDelete: Cascade)

  @@map("channel_webhook_logs")
}

model TelephonyTrunk {
  id              String        @id @default(uuid())
  channelConfigId String
  sipDomain       String
  username        String
  authPassword    String
  inboundNumber   String
  isRecordCalls   Boolean       @default(true)
  createdAt       DateTime      @default(now())

  channelConfig   ChannelConfig @relation(fields: [channelConfigId], references: [id], onDelete: Cascade)
  voiceSessions   VoiceCallSession[]

  @@map("telephony_trunks")
}

model VoiceCallSession {
  id              String        @id @default(uuid())
  trunkId         String
  callerNumber    String
  calleeNumber    String
  direction       String        @default("INBOUND")
  durationSeconds Int           @default(0)
  recordingUrl    String?
  status          String        @default("COMPLETED")
  startedAt       DateTime      @default(now())
  endedAt         DateTime?

  trunk           TelephonyTrunk @relation(fields: [trunkId], references: [id], onDelete: Cascade)

  @@map("voice_call_sessions")
}

// ==========================================
// CONVERSATION & MESSAGING ENGINE
// ==========================================

model Conversation {
  id             String           @id @default(uuid())
  organizationId String
  channelId      String?
  contactId      String?
  dealId         String?
  type           String           @default("DIRECT")
  title          String?
  status         String           @default("OPEN")
  priority       String           @default("MEDIUM")
  description    String?
  createdById    String
  metadata       String?
  lastMessageAt  DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channel        ChannelConfig?   @relation(fields: [channelId], references: [id], onDelete: SetNull)
  createdBy      User             @relation("CreatedConversations", fields: [createdById], references: [id], onDelete: Cascade)
  contact        Contact?         @relation(fields: [contactId], references: [id], onDelete: SetNull)
  deal           Deal?            @relation(fields: [dealId], references: [id], onDelete: SetNull)
  participants   ConversationParticipant[]
  messages       Message[]
  tickets        Ticket[]
  aiInsights     AiInsight[]

  @@map("conversations")
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  userId         String
  role           String       @default("MEMBER")
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime     @default(now())
  muted          Boolean      @default(false)

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@map("conversation_participants")
}

model Message {
  id             String        @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  type           String        @default("TEXT")
  metadata       String?
  replyToId      String?
  isEdited       Boolean       @default(false)
  isDeleted      Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User          @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  replyTo        Message?      @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        Message[]     @relation("MessageReplies")
  attachments    MessageAttachment[]
  receipts       MessageReceipt[]

  @@map("messages")
}

model MessageAttachment {
  id        String   @id @default(uuid())
  messageId String
  fileName  String
  fileUrl   String
  fileSize  Int
  mimeType  String
  createdAt DateTime @default(now())

  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("message_attachments")
}

model MessageReceipt {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  status    String   @default("DELIVERED")
  readAt    DateTime?
  updatedAt DateTime @updatedAt

  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@map("message_receipts")
}

model CannedResponse {
  id             String       @id @default(uuid())
  organizationId String
  createdById    String
  shortcut       String
  title          String
  content        String
  category       String       @default("GENERAL")
  usageCount     Int          @default(0)
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User         @relation("CreatedCannedResponses", fields: [createdById], references: [id], onDelete: Cascade)

  @@unique([organizationId, shortcut])
  @@map("canned_responses")
}

model Notification {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  type           String       @default("NEW_MESSAGE")
  title          String
  body           String
  link           String?
  isRead         Boolean      @default(false)
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model UserPresence {
  userId       String   @id
  status       String   @default("OFFLINE")
  customStatus String?
  lastActiveAt DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_presence")
}

// ==========================================
// CRM & CUSTOMER 360 CDP MODELS
// ==========================================

model Company {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  domain         String?
  industry       String?
  employeeCount  Int?
  annualRevenue  Float?
  website        String?
  address        String?
  city           String?
  country        String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts       Contact[]
  deals          Deal[]
  leads          Lead[]
  documents      CustomerDocument[]

  @@map("companies")
}

model Contact {
  id             String       @id @default(uuid())
  organizationId String
  companyId      String?
  firstName      String
  lastName       String
  email          String
  phone          String?
  jobTitle       String?
  avatarUrl      String?
  city           String?
  country        String?
  lifetimeValue  Float        @default(0.0)
  leadScore      Int          @default(0)
  tags           String       @default("[]")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company        Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  conversations  Conversation[]
  deals          Deal[]
  activities     Activity[]
  tasks          Task[]
  documents      CustomerDocument[]
  tickets        Ticket[]
  notes          CustomerNote[]
  csatResponses  CsatResponse[]
  tagAssignments TagAssignment[]
  customValues   CustomFieldValue[]

  @@map("contacts")
}

model CustomerNote {
  id        String   @id @default(uuid())
  contactId String
  authorId  String
  content   String
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())

  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  author    User     @relation("AuthoredNotes", fields: [authorId], references: [id], onDelete: Cascade)

  @@map("customer_notes")
}

model Lead {
  id             String       @id @default(uuid())
  organizationId String
  companyId      String?
  title          String
  contactName    String
  email          String
  phone          String?
  source         String       @default("WEBSITE")
  status         String       @default("NEW")
  score          Int          @default(0)
  assignedToId   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company        Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  assignedTo     User?        @relation("AssignedLeads", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@map("leads")
}

model LeadScoringRule {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  attribute      String
  operator       String       @default("EQUALS")
  value          String
  scorePoints    Int          @default(10)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("lead_scoring_rules")
}

model Pipeline {
  id             String          @id @default(uuid())
  organizationId String
  name           String
  isDefault      Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stages         PipelineStage[]
  deals          Deal[]

  @@map("pipelines")
}

model PipelineStage {
  id          String   @id @default(uuid())
  pipelineId  String
  name        String
  position    Int
  probability Int      @default(50)
  color       String?  @default("#0284c7")

  pipeline    Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals       Deal[]

  @@map("pipeline_stages")
}

model ProductCatalog {
  id             String             @id @default(uuid())
  organizationId String
  name           String
  sku            String             @unique
  description    String?
  unitPrice      Float
  currency       String             @default("USD")
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quoteItems     DealQuoteLineItem[]

  @@map("product_catalog")
}

model Deal {
  id                String        @id @default(uuid())
  organizationId    String
  pipelineId        String
  stageId           String
  contactId         String?
  companyId         String?
  assignedToId      String?
  title             String
  amount            Float
  currency          String        @default("USD")
  status            String        @default("OPEN")
  winLossReason     String?
  expectedCloseDate DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pipeline          Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stage             PipelineStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  contact           Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company           Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  assignedTo        User?         @relation("AssignedDeals", fields: [assignedToId], references: [id], onDelete: SetNull)
  conversations     Conversation[]
  activities        Activity[]
  tasks             Task[]
  quotes            DealQuote[]

  @@map("deals")
}

model DealQuote {
  id             String              @id @default(uuid())
  dealId         String
  createdById    String
  quoteNumber    String              @unique
  totalAmount    Float
  taxAmount      Float               @default(0.0)
  discountAmount Float               @default(0.0)
  status         String              @default("DRAFT")
  validUntil     DateTime
  notes          String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  deal           Deal                @relation(fields: [dealId], references: [id], onDelete: Cascade)
  createdBy      User                @relation("CreatedQuotes", fields: [createdById], references: [id], onDelete: Cascade)
  lineItems      DealQuoteLineItem[]

  @@map("deal_quotes")
}

model DealQuoteLineItem {
  id             String         @id @default(uuid())
  quoteId        String
  productId      String
  quantity       Int            @default(1)
  unitPrice      Float
  discount       Float          @default(0.0)
  totalPrice     Float

  quote          DealQuote      @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product        ProductCatalog @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("deal_quote_line_items")
}

model Activity {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  contactId      String?
  dealId         String?
  type           String       @default("NOTE")
  title          String
  notes          String?
  dueAt          DateTime?
  completedAt    DateTime?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation("UserActivities", fields: [userId], references: [id], onDelete: Cascade)
  contact        Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  deal           Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@map("activities")
}

model Task {
  id             String       @id @default(uuid())
  organizationId String
  assignedToId   String
  contactId      String?
  dealId         String?
  title          String
  description    String?
  status         String       @default("PENDING")
  priority       String       @default("MEDIUM")
  dueAt          DateTime?
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedTo     User         @relation("AssignedTasks", fields: [assignedToId], references: [id], onDelete: Cascade)
  contact        Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  deal           Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@map("tasks")
}

model CustomerDocument {
  id             String       @id @default(uuid())
  organizationId String
  contactId      String?
  companyId      String?
  uploadedById   String
  fileName       String
  fileUrl        String
  fileSize       Int
  mimeType       String
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact        Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company        Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  uploadedBy     User         @relation("UploadedDocuments", fields: [uploadedById], references: [id], onDelete: Cascade)

  @@map("customer_documents")
}

// ==========================================
// DATA ETL & BULK IMPORT ENGINE
// ==========================================

model EtlImportJob {
  id             String       @id @default(uuid())
  organizationId String
  createdById    String
  entityType     String       @default("CONTACT")
  fileName       String
  totalRows      Int          @default(0)
  processedRows  Int          @default(0)
  failedRows     Int          @default(0)
  status         String       @default("PENDING")
  fieldMapping   String       @default("{}")
  errorSummary   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User         @relation("UserEtlJobs", fields: [createdById], references: [id], onDelete: Cascade)

  @@map("etl_import_jobs")
}

// ==========================================
// HELPDESK, SLA & TICKET QUEUE MODELS
// ==========================================

model SlaPolicy {
  id                   String      @id @default(uuid())
  organizationId       String
  name                 String
  description          String?
  priority             String      @default("MEDIUM")
  firstResponseMinutes Int         @default(60)
  nextResponseMinutes  Int         @default(120)
  resolutionMinutes    Int         @default(480)
  isDefault            Boolean     @default(false)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tickets              Ticket[]
  breachLogs           SlaBreachLog[]

  @@map("sla_policies")
}

model SlaBreachLog {
  id             String       @id @default(uuid())
  slaPolicyId    String
  ticketId       String
  breachType     String       @default("FIRST_RESPONSE")
  targetMinutes  Int
  actualMinutes  Int
  breachedAt     DateTime     @default(now())

  slaPolicy      SlaPolicy    @relation(fields: [slaPolicyId], references: [id], onDelete: Cascade)
  ticket         Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("sla_breach_logs")
}

model TicketQueue {
  id             String              @id @default(uuid())
  organizationId String
  teamId         String?
  name           String
  description    String?
  strategy       String              @default("ROUND_ROBIN")
  isActive       Boolean             @default(true)
  createdAt      DateTime            @default(now())

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team           Team?               @relation(fields: [teamId], references: [id], onDelete: SetNull)
  members        TicketQueueMember[]
  tickets        Ticket[]

  @@map("ticket_queues")
}

model TicketQueueMember {
  id             String       @id @default(uuid())
  queueId        String
  userId         String
  isAvailable    Boolean      @default(true)
  maxTicketCount Int          @default(10)
  assignedCount  Int          @default(0)

  queue          TicketQueue  @relation(fields: [queueId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([queueId, userId])
  @@map("ticket_queue_members")
}

model TicketRoutingRule {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  conditionJson  String       @default("{}")
  targetQueueId  String
  priority       Int          @default(1)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("ticket_routing_rules")
}

model Ticket {
  id                 String         @id @default(uuid())
  organizationId     String
  teamId             String?
  queueId            String?
  contactId          String?
  conversationId     String?
  assignedToId       String?
  slaPolicyId        String?
  ticketNumber       String         @unique
  subject            String
  description        String
  priority           String         @default("MEDIUM")
  status             String         @default("OPEN")
  category           String         @default("GENERAL")
  firstResponseDueAt DateTime?
  resolutionDueAt   DateTime?
  firstRespondedAt   DateTime?
  resolvedAt         DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  organization       Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team               Team?          @relation("TeamTickets", fields: [teamId], references: [id], onDelete: SetNull)
  queue              TicketQueue?   @relation(fields: [queueId], references: [id], onDelete: SetNull)
  contact            Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  conversation       Conversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  assignedTo         User?          @relation("AssignedTickets", fields: [assignedToId], references: [id], onDelete: SetNull)
  slaPolicy          SlaPolicy?     @relation(fields: [slaPolicyId], references: [id], onDelete: SetNull)
  comments           TicketComment[]
  breachLogs         SlaBreachLog[]
  csatResponses      CsatResponse[]

  @@map("tickets")
}

model TicketComment {
  id         String   @id @default(uuid())
  ticketId   String
  userId     String
  isInternal Boolean  @default(false)
  content    String
  attachments String  @default("[]")
  createdAt  DateTime @default(now())

  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user       User     @relation("UserTicketComments", fields: [userId], references: [id], onDelete: Cascade)

  @@map("ticket_comments")
}

model CsatSurvey {
  id             String       @id @default(uuid())
  organizationId String
  title          String
  question       String       @default("How satisfied are you with our support?")
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  responses      CsatResponse[]

  @@map("csat_surveys")
}

model CsatResponse {
  id             String       @id @default(uuid())
  surveyId       String
  ticketId       String
  contactId      String
  agentId        String?
  rating         Int          // 1 to 5
  feedback       String?
  createdAt      DateTime     @default(now())

  survey         CsatSurvey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  ticket         Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  contact        Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  agent          User?        @relation("AgentCsatResponses", fields: [agentId], references: [id], onDelete: SetNull)

  @@map("csat_responses")
}

// ==========================================
// KNOWLEDGE BASE & AI ENGINE MODELS
// ==========================================

model KnowledgeArticle {
  id             String                   @id @default(uuid())
  organizationId String
  authorId       String
  title          String
  slug           String                   @unique
  category       String
  content        String
  isPublished    Boolean                  @default(true)
  viewCount      Int                      @default(0)
  helpfulCount   Int                      @default(0)
  unhelpfulCount Int                      @default(0)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author         User                     @relation("AuthoredArticles", fields: [authorId], references: [id], onDelete: Cascade)
  versions       KnowledgeArticleVersion[]

  @@map("knowledge_articles")
}

model KnowledgeArticleVersion {
  id          String           @id @default(uuid())
  articleId   String
  authorId    String
  version     Int
  title       String
  content     String
  changeLog   String?
  createdAt   DateTime         @default(now())

  article     KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  author      User             @relation("VersionAuthors", fields: [authorId], references: [id], onDelete: Cascade)

  @@map("knowledge_article_versions")
}

model AiPromptTemplate {
  id             String       @id @default(uuid())
  organizationId String
  createdById    String
  name           String
  purpose        String       @default("SUMMARIZATION")
  promptText     String
  temperature    Float        @default(0.7)
  modelName      String       @default("gpt-4-turbo")
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User         @relation("CreatedPrompts", fields: [createdById], references: [id], onDelete: Cascade)

  @@map("ai_prompt_templates")
}

model AiInsight {
  id             String       @id @default(uuid())
  conversationId String
  sentiment      String       @default("NEUTRAL")
  summary        String
  nextBestAction String?
  leadScore      Int?
  suggestedReply String?
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("ai_insights")
}

// ==========================================
// WORKFLOW & AUTOMATION ENGINE MODELS
// ==========================================

model WorkflowRule {
  id             String              @id @default(uuid())
  organizationId String
  createdById    String
  name           String
  description    String?
  triggerType    String
  actionType     String
  isActive       Boolean             @default(true)
  config         String              @default("{}")
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User                @relation("CreatedWorkflows", fields: [createdById], references: [id], onDelete: Cascade)
  nodes          WorkflowNode[]
  edges          WorkflowEdge[]
  executions     WorkflowExecution[]

  @@map("workflow_rules")
}

model WorkflowNode {
  id             String       @id @default(uuid())
  workflowRuleId String
  nodeType       String       @default("ACTION")
  label          String
  positionX      Float        @default(0)
  positionY      Float        @default(0)
  config         String       @default("{}")

  workflowRule   WorkflowRule @relation(fields: [workflowRuleId], references: [id], onDelete: Cascade)

  @@map("workflow_nodes")
}

model WorkflowEdge {
  id             String       @id @default(uuid())
  workflowRuleId String
  sourceNodeId   String
  targetNodeId   String
  label          String?

  workflowRule   WorkflowRule @relation(fields: [workflowRuleId], references: [id], onDelete: Cascade)

  @@map("workflow_edges")
}

model WorkflowExecution {
  id             String       @id @default(uuid())
  workflowRuleId String
  status         String       @default("SUCCESS")
  executionTimeMs Int         @default(0)
  output         String?
  errorMessage   String?
  executedAt     DateTime     @default(now())

  rule           WorkflowRule @relation(fields: [workflowRuleId], references: [id], onDelete: Cascade)

  @@map("workflow_executions")
}

// ==========================================
// MARKETING & CAMPAIGN TEMPLATES
// ==========================================

model EmailTemplate {
  id             String       @id @default(uuid())
  organizationId String
  createdById    String
  name           String
  subject        String
  bodyHtml       String
  bodyText       String?
  variables      String       @default("[]")
  category       String       @default("MARKETING")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User         @relation("CreatedTemplates", fields: [createdById], references: [id], onDelete: Cascade)

  @@map("email_templates")
}

model BroadcastCampaign {
  id             String       @id @default(uuid())
  organizationId String
  createdById    String
  name           String
  channelType    String       @default("EMAIL")
  subject        String?
  content        String
  segmentQuery   String       @default("{}")
  status         String       @default("DRAFT")
  sentCount      Int          @default(0)
  openCount      Int          @default(0)
  clickCount     Int          @default(0)
  scheduledAt    DateTime?
  sentAt         DateTime?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User         @relation("CreatedCampaigns", fields: [createdById], references: [id], onDelete: Cascade)

  @@map("broadcast_campaigns")
}

model Macro {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  description    String?
  actions        String       @default("[]")
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("macros")
}

model ReportDefinition {
  id             String       @id @default(uuid())
  organizationId String
  createdById    String
  name           String
  reportType     String       @default("REVENUE")
  metrics        String       @default("[]")
  dimensions     String       @default("[]")
  filters        String       @default("{}")
  chartType      String       @default("BAR")
  isPublic       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User         @relation("CreatedReports", fields: [createdById], references: [id], onDelete: Cascade)

  @@map("report_definitions")
}

// ==========================================
// AUDIT, SECURITY & EXTENSIBILITY
// ==========================================

model ApiKey {
  id             String       @id @default(uuid())
  organizationId String
  createdById    String
  name           String
  keyHash        String       @unique
  prefix         String
  permissions    String       @default("[]")
  expiresAt      DateTime?
  lastUsedAt     DateTime?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User         @relation("CreatedApiKeys", fields: [createdById], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

model WebhookEndpoint {
  id             String         @id @default(uuid())
  organizationId String
  url            String
  secret         String
  events         String         @default("[]")
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries     WebhookEvent[]

  @@map("webhook_endpoints")
}

model WebhookEvent {
  id                String          @id @default(uuid())
  webhookEndpointId String
  eventType         String
  payload           String          @default("{}")
  responseCode      Int?
  responseBody      String?
  status            String          @default("DELIVERED")
  retryCount        Int             @default(0)
  createdAt         DateTime        @default(now())

  endpoint          WebhookEndpoint @relation(fields: [webhookEndpointId], references: [id], onDelete: Cascade)

  @@map("webhook_events")
}

model CustomFieldDefinition {
  id             String       @id @default(uuid())
  organizationId String
  entityType     String
  fieldKey       String
  label          String
  dataType       String       @default("STRING")
  isRequired     Boolean      @default(false)
  options        String       @default("[]")
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  values         CustomFieldValue[]

  @@unique([organizationId, entityType, fieldKey])
  @@map("custom_field_definitions")
}

model CustomFieldValue {
  id             String                @id @default(uuid())
  definitionId   String
  contactId      String?
  value          String

  definition     CustomFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  contact        Contact?              @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@map("custom_field_values")
}

model EntityTag {
  id             String          @id @default(uuid())
  organizationId String
  name           String
  color          String          @default("#3b82f6")
  createdAt      DateTime        @default(now())

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignments    TagAssignment[]

  @@unique([organizationId, name])
  @@map("entity_tags")
}

model TagAssignment {
  id             String       @id @default(uuid())
  tagId          String
  contactId      String?
  entityType     String       @default("CONTACT")
  entityId       String
  createdAt      DateTime     @default(now())

  tag            EntityTag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  contact        Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@map("tag_assignments")
}

model AuditLog {
  id             String        @id @default(uuid())
  organizationId String?
  userId         String?
  action         String
  entityType     String?
  entityId       String?
  metadata       String?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime      @default(now())

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model SecurityLog {
  id        String   @id @default(uuid())
  userId    String?
  event     String
  ipAddress String?
  userAgent String?
  metadata  String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("security_logs")
}
