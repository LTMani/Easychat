datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String               @id @default(uuid())
  email            String               @unique
  passwordHash     String
  firstName        String
  lastName         String
  avatarUrl        String?
  isEmailVerified  Boolean              @default(false)
  twoFactorEnabled Boolean              @default(false)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  memberships           OrganizationMember[]
  sessions              Session[]
  refreshTokens         RefreshToken[]
  auditLogs             AuditLog[]
  securityLogs          SecurityLog[]

  createdConversations  Conversation[]           @relation("CreatedConversations")
  participations        ConversationParticipant[]
  sentMessages          Message[]                @relation("SentMessages")
  messageReceipts       MessageReceipt[]
  notifications         Notification[]
  presence              UserPresence?

  assignedLeads         Lead[]                   @relation("AssignedLeads")
  assignedDeals         Deal[]                   @relation("AssignedDeals")
  assignedTasks         Task[]                   @relation("AssignedTasks")
  uploadedDocuments     CustomerDocument[]       @relation("UploadedDocuments")
  assignedTickets       Ticket[]                 @relation("AssignedTickets")
  ticketComments        TicketComment[]          @relation("UserTicketComments")
  authoredArticles      KnowledgeArticle[]       @relation("AuthoredArticles")
  activities            Activity[]               @relation("UserActivities")
  createdWorkflows      WorkflowRule[]           @relation("CreatedWorkflows")
  apiKeys               ApiKey[]                 @relation("CreatedApiKeys")
  createdReports        ReportDefinition[]       @relation("CreatedReports")
  createdTemplates      EmailTemplate[]          @relation("CreatedTemplates")
  cannedResponses       CannedResponse[]         @relation("CreatedCannedResponses")
  campaigns             BroadcastCampaign[]      @relation("CreatedCampaigns")
  customerNotes         CustomerNote[]           @relation("AuthoredNotes")

  @@map("users")
}

model Organization {
  id            String               @id @default(uuid())
  name          String
  slug          String               @unique
  logoUrl       String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  members       OrganizationMember[]
  teams         Team[]
  conversations Conversation[]
  notifications Notification[]
  auditLogs     AuditLog[]

  companies     Company[]
  contacts      Contact[]
  leads         Lead[]
  pipelines     Pipeline[]
  deals         Deal[]
  activities    Activity[]
  tasks         Task[]
  documents     CustomerDocument[]
  tickets       Ticket[]
  articles      KnowledgeArticle[]
  workflows     WorkflowRule[]
  apiKeys       ApiKey[]
  webhooks      WebhookEndpoint[]
  customFields  CustomFieldDefinition[]
  channels      ChannelConfig[]
  reports       ReportDefinition[]
  templates     EmailTemplate[]
  cannedResponses CannedResponse[]
  slaPolicies   SlaPolicy[]
  campaigns     BroadcastCampaign[]
  macros        Macro[]
  leadScoring   LeadScoringRule[]

  @@map("organizations")
}

model Team {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        TeamMember[]
  tickets        Ticket[]     @relation("TeamTickets")

  @@map("teams")
}

model OrganizationMember {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  role           String       @default("MEMBER")
  status         String       @default("ACTIVE")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  teams          TeamMember[]

  @@unique([organizationId, userId])
  @@map("organization_members")
}

model TeamMember {
  id                   String             @id @default(uuid())
  teamId               String
  organizationMemberId String
  createdAt            DateTime           @default(now())

  team                 Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  member               OrganizationMember @relation(fields: [organizationMemberId], references: [id], onDelete: Cascade)

  @@unique([teamId, organizationMemberId])
  @@map("team_members")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model ChannelConfig {
  id             String       @id @default(uuid())
  organizationId String
  type           String       @default("WHATSAPP")
  name           String
  credentials    String       @default("{}")
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversations  Conversation[]
  webhookLogs    ChannelWebhookLog[]

  @@map("channel_configs")
}

model ChannelWebhookLog {
  id              String        @id @default(uuid())
  channelConfigId String
  eventType       String
  payload         String        @default("{}")
  status          String        @default("PROCESSED")
  createdAt       DateTime      @default(now())

  channelConfig   ChannelConfig @relation(fields: [channelConfigId], references: [id], onDelete: Cascade)

  @@map("channel_webhook_logs")
}

model Conversation {
  id             String           @id @default(uuid())
  organizationId String
  channelId      String?
  contactId      String?
  dealId         String?
  type           String           @default("DIRECT")
  title          String?
  description    String?
  createdById    String
  metadata       String?
  lastMessageAt  DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channel        ChannelConfig?   @relation(fields: [channelId], references: [id], onDelete: SetNull)
  createdBy      User             @relation("CreatedConversations", fields: [createdById], references: [id], onDelete: Cascade)
  contact        Contact?         @relation(fields: [contactId], references: [id], onDelete: SetNull)
  deal           Deal?            @relation(fields: [dealId], references: [id], onDelete: SetNull)
  participants   ConversationParticipant[]
  messages       Message[]
  tickets        Ticket[]
  aiInsights     AiInsight[]

  @@map("conversations")
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  userId         String
  role           String       @default("MEMBER")
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime     @default(now())
  muted          Boolean      @default(false)

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@map("conversation_participants")
}

model Message {
  id             String        @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  type           String        @default("TEXT")
  metadata       String?
  replyToId      String?
  isEdited       Boolean       @default(false)
  isDeleted      Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User          @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  replyTo        Message?      @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        Message[]     @relation("MessageReplies")
  attachments    MessageAttachment[]
  receipts       MessageReceipt[]

  @@map("messages")
}

model MessageAttachment {
  id        String   @id @default(uuid())
  messageId String
  fileName  String
  fileUrl   String
  fileSize  Int
  mimeType  String
  createdAt DateTime @default(now())

  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("message_attachments")
}

model MessageReceipt {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  status    String   @default("DELIVERED")
  readAt    DateTime?
  updatedAt DateTime @updatedAt

  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@map("message_receipts")
}

model CannedResponse {
  id             String       @id @default(uuid())
  organizationId String
  createdById    String
  shortcut       String
  title          String
  content        String
  category       String       @default("GENERAL")
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User         @relation("CreatedCannedResponses", fields: [createdById], references: [id], onDelete: Cascade)

  @@unique([organizationId, shortcut])
  @@map("canned_responses")
}

model Notification {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  type           String       @default("NEW_MESSAGE")
  title          String
  body           String
  link           String?
  isRead         Boolean      @default(false)
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model UserPresence {
  userId       String   @id
  status       String   @default("OFFLINE")
  customStatus String?
  lastActiveAt DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_presence")
}

model Company {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  domain         String?
  industry       String?
  employeeCount  Int?
  annualRevenue  Float?
  website        String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts       Contact[]
  deals          Deal[]
  leads          Lead[]
  documents      CustomerDocument[]

  @@map("companies")
}

model Contact {
  id             String       @id @default(uuid())
  organizationId String
  companyId      String?
  firstName      String
  lastName       String
  email          String
  phone          String?
  jobTitle       String?
  tags           String       @default("[]")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company        Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  conversations  Conversation[]
  deals          Deal[]
  activities     Activity[]
  tasks          Task[]
  documents      CustomerDocument[]
  tickets        Ticket[]
  notes          CustomerNote[]

  @@map("contacts")
}

model CustomerNote {
  id        String   @id @default(uuid())
  contactId String
  authorId  String
  content   String
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())

  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  author    User     @relation("AuthoredNotes", fields: [authorId], references: [id], onDelete: Cascade)

  @@map("customer_notes")
}

model Lead {
  id             String       @id @default(uuid())
  organizationId String
  companyId      String?
  title          String
  contactName    String
  email          String
  phone          String?
  source         String       @default("WEBSITE")
  status         String       @default("NEW")
  score          Int          @default(0)
  assignedToId   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company        Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  assignedTo     User?        @relation("AssignedLeads", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@map("leads")
}

model LeadScoringRule {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  attribute      String
  operator       String       @default("EQUALS")
  value          String
  scorePoints    Int          @default(10)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("lead_scoring_rules")
}

model Pipeline {
  id             String          @id @default(uuid())
  organizationId String
  name           String
  isDefault      Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stages         PipelineStage[]
  deals          Deal[]

  @@map("pipelines")
}

model PipelineStage {
  id          String   @id @default(uuid())
  pipelineId  String
  name        String
  position    Int
  probability Int      @default(50)
  color       String?  @default("#0284c7")

  pipeline    Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals       Deal[]

  @@map("pipeline_stages")
}

model Deal {
  id                String        @id @default(uuid())
  organizationId    String
  pipelineId        String
  stageId           String
  contactId         String?
  companyId         String?
  assignedToId      String?
  title             String
  amount            Float
  currency          String        @default("USD")
  status            String        @default("OPEN")
  winLossReason     String?
  expectedCloseDate DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pipeline          Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stage             PipelineStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  contact           Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company           Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  assignedTo        User?         @relation("AssignedDeals", fields: [assignedToId], references: [id], onDelete: SetNull)
  conversations     Conversation[]
  activities        Activity[]
  tasks             Task[]

  @@map("deals")
}

model Activity {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  contactId      String?
  dealId         String?
  type           String       @default("NOTE")
  title          String
  notes          String?
  dueAt          DateTime?
  completedAt    DateTime?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation("UserActivities", fields: [userId], references: [id], onDelete: Cascade)
  contact        Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  deal           Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@map("activities")
}

model Task {
  id             String       @id @default(uuid())
  organizationId String
  assignedToId   String
  contactId      String?
  dealId         String?
  title          String
  description    String?
  status         String       @default("PENDING")
  dueAt          DateTime?
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedTo     User         @relation("AssignedTasks", fields: [assignedToId], references: [id], onDelete: Cascade)
  contact        Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  deal           Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@map("tasks")
}

model CustomerDocument {
  id             String       @id @default(uuid())
  organizationId String
  contactId      String?
  companyId      String?
  uploadedById   String
  fileName       String
  fileUrl        String
  fileSize       Int
  mimeType       String
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact        Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company        Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  uploadedBy     User         @relation("UploadedDocuments", fields: [uploadedById], references: [id], onDelete: Cascade)

  @@map("customer_documents")
}

model SlaPolicy {
  id                 String   @id @default(uuid())
  organizationId     String
  name               String
  priority           String   @default("MEDIUM")
  firstResponseMinutes Int    @default(60)
  resolutionMinutes  Int      @default(480)
  isDefault          Boolean  @default(false)
  createdAt          DateTime @default(now())

  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("sla_policies")
}

model Ticket {
  id                 String         @id @default(uuid())
  organizationId     String
  teamId             String?
  contactId          String?
  conversationId     String?
  assignedToId       String?
  ticketNumber       String         @unique
  subject            String
  description        String
  priority           String         @default("MEDIUM")
  status             String         @default("OPEN")
  firstResponseDueAt DateTime?
  resolutionDueAt   DateTime?
  resolvedAt         DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  organization       Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team               Team?          @relation("TeamTickets", fields: [teamId], references: [id], onDelete: SetNull)
  contact            Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  conversation       Conversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  assignedTo         User?          @relation("AssignedTickets", fields: [assignedToId], references: [id], onDelete: SetNull)
  comments           TicketComment[]

  @@map("tickets")
}

model TicketComment {
  id         String   @id @default(uuid())
  ticketId   String
  userId     String
  isInternal Boolean  @default(false)
  content    String
  createdAt  DateTime @default(now())

  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user       User     @relation("UserTicketComments", fields: [userId], references: [id], onDelete: Cascade)

  @@map("ticket_comments")
}

model KnowledgeArticle {
  id             String       @id @default(uuid())
  organizationId String
  authorId       String
  title          String
  slug           String       @unique
  category       String
  content        String
  isPublished    Boolean      @default(true)
  viewCount      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author         User         @relation("AuthoredArticles", fields: [authorId], references: [id], onDelete: Cascade)

  @@map("knowledge_articles")
}

model WorkflowRule {
  id             String              @id @default(uuid())
  organizationId String
  createdById    String
  name           String
  triggerType    String
  actionType     String
  isActive       Boolean             @default(true)
  config         String              @default("{}")
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User                @relation("CreatedWorkflows", fields: [createdById], references: [id], onDelete: Cascade)
  nodes          WorkflowNode[]
  edges          WorkflowEdge[]
  executions     WorkflowExecution[]

  @@map("workflow_rules")
}

model WorkflowNode {
  id             String       @id @default(uuid())
  workflowRuleId String
  nodeType       String       @default("ACTION")
  label          String
  positionX      Float        @default(0)
  positionY      Float        @default(0)
  config         String       @default("{}")

  workflowRule   WorkflowRule @relation(fields: [workflowRuleId], references: [id], onDelete: Cascade)

  @@map("workflow_nodes")
}

model WorkflowEdge {
  id             String       @id @default(uuid())
  workflowRuleId String
  sourceNodeId   String
  targetNodeId   String
  label          String?

  workflowRule   WorkflowRule @relation(fields: [workflowRuleId], references: [id], onDelete: Cascade)

  @@map("workflow_edges")
}

model WorkflowExecution {
  id             String       @id @default(uuid())
  workflowRuleId String
  status         String       @default("SUCCESS")
  output         String?
  executedAt     DateTime     @default(now())

  rule           WorkflowRule @relation(fields: [workflowRuleId], references: [id], onDelete: Cascade)

  @@map("workflow_executions")
}

model EmailTemplate {
  id             String       @id @default(uuid())
  organizationId String
  createdById    String
  name           String
  subject        String
  bodyHtml       String
  bodyText       String?
  variables      String       @default("[]")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User         @relation("CreatedTemplates", fields: [createdById], references: [id], onDelete: Cascade)

  @@map("email_templates")
}

model BroadcastCampaign {
  id             String       @id @default(uuid())
  organizationId String
  createdById    String
  name           String
  channelType    String       @default("EMAIL")
  subject        String?
  content        String
  segmentQuery   String       @default("{}")
  status         String       @default("DRAFT")
  sentCount      Int          @default(0)
  openCount      Int          @default(0)
  scheduledAt    DateTime?
  sentAt         DateTime?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User         @relation("CreatedCampaigns", fields: [createdById], references: [id], onDelete: Cascade)

  @@map("broadcast_campaigns")
}

model Macro {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  description    String?
  actions        String       @default("[]")
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("macros")
}

model ReportDefinition {
  id             String       @id @default(uuid())
  organizationId String
  createdById    String
  name           String
  reportType     String       @default("REVENUE")
  metrics        String       @default("[]")
  dimensions     String       @default("[]")
  filters        String       @default("{}")
  chartType      String       @default("BAR")
  isPublic       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User         @relation("CreatedReports", fields: [createdById], references: [id], onDelete: Cascade)

  @@map("report_definitions")
}

model ApiKey {
  id             String       @id @default(uuid())
  organizationId String
  createdById    String
  name           String
  keyHash        String       @unique
  prefix         String
  expiresAt      DateTime?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User         @relation("CreatedApiKeys", fields: [createdById], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

model WebhookEndpoint {
  id             String         @id @default(uuid())
  organizationId String
  url            String
  secret         String
  events         String         @default("[]")
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries     WebhookEvent[]

  @@map("webhook_endpoints")
}

model WebhookEvent {
  id                String          @id @default(uuid())
  webhookEndpointId String
  eventType         String
  payload           String          @default("{}")
  responseCode      Int?
  status            String          @default("DELIVERED")
  createdAt         DateTime        @default(now())

  endpoint          WebhookEndpoint @relation(fields: [webhookEndpointId], references: [id], onDelete: Cascade)

  @@map("webhook_events")
}

model CustomFieldDefinition {
  id             String       @id @default(uuid())
  organizationId String
  entityType     String
  fieldKey       String
  label          String
  dataType       String       @default("STRING")
  isRequired     Boolean      @default(false)
  options        String       @default("[]")
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, entityType, fieldKey])
  @@map("custom_field_definitions")
}

model AiInsight {
  id             String       @id @default(uuid())
  conversationId String
  sentiment      String       @default("NEUTRAL")
  summary        String
  nextBestAction String?
  leadScore      Int?
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("ai_insights")
}

model AuditLog {
  id             String        @id @default(uuid())
  organizationId String?
  userId         String?
  action         String
  entityType     String?
  entityId       String?
  metadata       String?
  ipAddress      String?
  createdAt      DateTime      @default(now())

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model SecurityLog {
  id        String   @id @default(uuid())
  userId    String?
  event     String
  ipAddress String?
  userAgent String?
  metadata  String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("security_logs")
}
